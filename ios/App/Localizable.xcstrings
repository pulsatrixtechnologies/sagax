    "To generate images, configure the shared image provider in Sagax on your computer. Provider keys cannot be added from this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour générer des images, configure le fournisseur d'images partagé dans Sagax sur ton ordinateur. Les clés de fournisseur ne peuvent pas être ajoutées depuis cet appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gerar imagens, configure o provedor de imagens compartilhado no Sagax no seu computador. Não é possível adicionar chaves de provedor por este dispositivo."
          }
        }
      }
    },
