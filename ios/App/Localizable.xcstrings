          }
        }
      }
    },
    "The bot and its conversations will be deleted. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bot and its conversations will be deleted. This cannot be undone."
