        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe donne sa pleine mesure avec des bots qui se partagent le travail."
          }
        }
      }
    },
    "A hardware key (such as a YubiKey), or a passkey on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé matérielle (comme une YubiKey) ou une clé d'accès sur cet appareil."
          }
        }
      }
    },
    "A hidden person or group comes back when a new message arrives, so a colleague is never missed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden person or group comes back when a new message arrives, so a colleague is never missed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne ou un groupe masqué revient à l'arrivée d'un nouveau message, pour ne jamais manquer un collègue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa ou grupo oculto volta quando chega uma nova mensagem, para nunca perder um colega."
          }
        }
      }
    },
    "A key in Settings > Connections serves as the organization's key.": {
      "localizations": {
