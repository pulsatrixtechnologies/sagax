{
  "protocolVersion": 1,
  "agentCapabilities": {
    "loadSession": true,
    "promptCapabilities": {
      "image": true,
      "audio": false,
      "embeddedContext": true
    },
    "mcpCapabilities": {
      "http": true,
      "sse": true
    },
    "sessionCapabilities": {
      "list": {},
      "resume": {},
      "close": {}
    },
    "auth": {},
    "_meta": {
      "x.ai/fs_notify": true,
      "x.ai/hooks": {
        "blockingEvents": [
          "pre_tool_use",
          "stop",
          "subagent_stop"
        ],
        "decisions": [
          "deny",
          "block"
        ],
        "stopSignals": [
          "continue",
          "stopReason",
          "additionalContext"
        ]
      },
      "x.ai/capabilities": {
        "toolOverrides": {
          "x_keyword_search": true,
          "x_semantic_search": true,
          "x_user_search": false,
          "x_thread_fetch": false
        }
      }
    }
  },
  "authMethods": [
    {
      "id": "xai.api_key",
      "name": "xai.api_key",
      "description": "XAI_API_KEY or api_key/env_key in config.toml"
    },
    {
      "id": "cached_token",
      "name": "cached_token",
      "description": "Cached token from ~/.grok/auth.json"
    },
    {
      "id": "grok.com",
      "name": "Grok",
      "description": "Sign in with Grok"
    }
  ],
  "_meta": {
    "agentVersion": "1.0.77",
    "grokShell": true,
    "defaultAuthMethodId": "cached_token",
    "mcpApps": false,
    "x.ai/mcp/sdk": true,
    "x.ai/pluginDirs": true,
    "keysLeftOut": [
      "agentId",
      "agentInstanceId",
      "availableCommands",
      "cancelRewind",
      "currentWorkingDirectory",
      "feedbackTraceOffer",
      "hostname",
      "mcpServers",
      "metadata",
      "modelState",
      "sessionRecap",
      "voiceMode"
    ]
  }
}
