# The mascot body catalogs are generated by scripts/gen-mascot-bodies.ts, which
# writes LF. scripts/mascot-bodies/generated.test.mjs re-runs the generator and
# compares the result to what is checked in, so if git hands Windows a CRLF
# checkout every line differs and the drift guard fails for a reason that has
# nothing to do with drift. Pin them to LF on every platform.
shared/mascot-bodies.ts text eol=lf
# git runs hooks through sh; a CRLF shebang line is "/bin/sh^M: bad interpreter" on every platform.
scripts/git-hooks/* text eol=lf
deploy/podman/*.sh text eol=lf
# Vendor patch hashes and original notices must survive Windows checkout
# byte-for-byte. Do not let core.autocrlf rewrite these reviewed inputs.
third_party/browser/** text eol=lf
# The live-eval judge prompts are checksummed in their manifest, and the golden
# scenarios are compared byte for byte with what the redactor writes (LF), in
# evals/live/live-suite.test.ts and evals/golden/golden.test.ts. A CRLF checkout
# on Windows fails both for a reason that has nothing to do with the evals.
evals/live/judge/prompts/** text eol=lf
evals/golden/**/*.json text eol=lf
# The bundled model catalog is compared byte for byte with what
# scripts/build-model-catalog.mjs writes (LF), and its licence text with the
# LICENSE files, in scripts/build-model-catalog.test.mjs and by --check.
server/model-catalog/models-dev.snapshot.json text eol=lf
third_party/models-dev/LICENSE text eol=lf
third_party/opencode/LICENSE text eol=lf
# scripts/docker-image.test.ts and server/cloud-home.test.ts read the
# Dockerfile's instructions line by line, joining a line that ends in "\" to
# the next. A CRLF checkout on Windows ends those lines in "\r", so nothing
# joins and every layering, healthcheck and trust check fails for a reason
# that has nothing to do with the image. Docker itself reads LF everywhere.
Dockerfile text eol=lf
# The Electron catalog copy is compared byte for byte with what
# scripts/gen-electron-org-library-catalog.mjs writes in
# electron/org-library-catalog.node-test.mjs, and the generator keeps the line
# endings of its source. The switch tracks stylesheet is compared byte for
# byte with what scripts/gen-switch-tokens.mjs writes (LF) in
# src/lib/switch-colors.test.ts. A CRLF checkout on Windows fails both for a
# reason that has nothing to do with drift. Pin them to LF on every platform.
shared/org-library-catalog.ts text eol=lf
electron/org-library-catalog.mjs text eol=lf
src/styles/skin-switch.css text eol=lf
