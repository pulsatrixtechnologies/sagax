            "state": "translated",
            "value": "Le bot n'a pas pu être créé. Réessayez."
          }
        }
      }
    },
    "The bot goes back to this version (%@). The current version stays in Changes, so you can come back to it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot revient à cette version (%@). La version actuelle reste dans Changements : tu pourras y revenir."
          }
        }
      }
    },
    "The bot is busy. Stop it first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bot is busy. Stop it first."
          }
        },
        "fr": {
