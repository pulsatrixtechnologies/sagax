        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courriels, messages, publications, invitations et paiements par les apps connectées. Lire et rédiger ne comptent jamais. Cela s'applique à tous les niveaux d'approbation, y compris l'accès complet."
          }
