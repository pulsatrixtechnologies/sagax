      }
    },
    "The spend limit is reached: the voice stops here. The answers stay in the chat.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The spend limit is reached: the voice stops here. The answers stay in the chat." } },
        "fr": { "stringUnit": { "state": "translated", "value": "La limite de dépenses est atteinte : la voix s'arrête ici. Les réponses restent dans le chat." } }
      }
    },
    "xAI has no credits left for %@. %@ The answers stay in the chat.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "xAI has no credits left for %@. %@ The answers stay in the chat." } },
        "fr": { "stringUnit": { "state": "translated", "value": "xAI n'a plus de crédits pour %@. %@ Les réponses restent dans le chat." } }
      }
    },
    "The xAI account has no voice credits left, or the spend limit is reached. The answers stay in the chat.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The xAI account has no voice credits left, or the spend limit is reached. The answers stay in the chat." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le compte xAI n'a plus de crédits pour la voix, ou la limite de dépenses est atteinte. Les réponses restent dans le chat." } }
      }
    },
    "xAI rejected %@: invalid, revoked, or without voice permission. %@ The answers stay in the chat.": {
