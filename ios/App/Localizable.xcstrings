    "The owner's engine, subscription or local model answers everyone who writes to this bot: they need nothing of their own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owner's engine, subscription or local model answers everyone who writes to this bot: they need nothing of their own."
