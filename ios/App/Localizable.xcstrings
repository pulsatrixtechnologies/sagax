    "Give the topic a name: letters, numbers, spaces, dots or dashes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the topic a name: letters, numbers, spaces, dots or dashes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un nom au sujet : lettres, chiffres, espaces, points ou tirets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome ao tópico: letras, números, espaços, pontos ou hífens."
          }
        }
      }
    },
    "Put %@ back the way it was.": {
      "localizations": {
        "en": {
          "stringUnit": {
