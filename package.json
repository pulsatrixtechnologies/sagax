{
  "name": "openmausbot",
  "private": true,
  "version": "0.1.107",
  "baseVersion": "0.1.107",
  "forkVersion": "0.8.25",
  "description": "Pulsatrix Sagax: a local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/pulsatrixtechnologies/sagax",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulsatrixtechnologies/sagax.git"
  },
  "author": {
    "name": "Pulsatrix Technologies Inc."
  },
  "license": "SEE LICENSE IN LICENSE",
  "desktopName": "com.openmausbot.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:terms": "node scripts/check-source-terms.mjs",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "check:unused": "node scripts/check-unused.mjs",
    "gen:switch": "node scripts/gen-switch-tokens.mjs",
    "gen:bubble": "node scripts/gen-bubble-tokens.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "verify:merge": "node scripts/verify-merge.mjs",
    "dev": "vite",
    "docs:dev": "pnpm --filter @sagax/docs dev",
    "docs:build": "pnpm --filter @sagax/docs build",
    "docs:preview": "pnpm --filter @sagax/docs preview",
    "companion": "node --experimental-strip-types companion/src/index.ts",
    "omb": "node --experimental-strip-types server/openmausbot.ts",
    "pair": "node --experimental-strip-types server/openmausbot.ts pair",
    "dev:server": "node --experimental-strip-types server/dev-server.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "health-scan": "node --experimental-strip-types server/health-scan.ts",
    "control:omb": "node --experimental-strip-types scripts/control-omb.ts",
    "eval": "node --experimental-strip-types evals/runners/run-evals.ts",
    "dev:desktop": "node scripts/prepare-cloudflared.mjs --current && node scripts/dev-desktop.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.gallery.json",
    "test": "vitest run && pnpm test:electron && pnpm test:packaged-server",
    "test:electron": "node --test \"electron/*.node-test.mjs\"",
    "test:pages-open": "vite build && vitest run scripts/testing/pages-open-ui.e2e.test.ts",
    "voice:acceptance": "node --experimental-transform-types --import ./scripts/voice-benchmark/register-asset-urls.mjs scripts/voice-benchmark/cli.ts",
    "voice:acceptance:real": "node --experimental-transform-types --import ./scripts/voice-benchmark/register-asset-urls.mjs scripts/voice-benchmark/cli.ts --profile real",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "bench:persistence": "node --experimental-strip-types scripts/bench-persistence.ts",
    "bench:routine-watch": "node --experimental-strip-types --expose-gc scripts/bench-routine-watch.ts",
    "test:watch": "vitest",
    "test:unit": "node scripts/testing/vitest-shards.mjs --group unit",
    "test:e2e": "node scripts/testing/vitest-shards.mjs --group e2e",
    "test:shards": "node scripts/testing/vitest-shards.mjs",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "check:no-phone-home": "node scripts/check-no-phone-home.mjs --require-bundles",
    "preview": "vite preview",
    "gen:bodies": "node --experimental-strip-types scripts/gen-mascot-bodies.ts",
    "build:server": "node --experimental-strip-types scripts/self-knowledge/generate.ts && tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "gen:self-knowledge": "node --experimental-strip-types scripts/self-knowledge/generate.ts",
    "gen:settings-doc": "node --experimental-strip-types scripts/settings-actions/doc.ts",
    "build:companion": "tsc -p tsconfig.companion.build.json && node scripts/mark-module-scope.mjs dist-companion",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:cua:win": "node scripts/prepare-cua-win.mjs",
    "smoke:cua-win": "node scripts/smoke-cua-win-embedded.mjs",
    "build:android-tools": "node scripts/prepare-android-tools.mjs",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:tailcat": "node scripts/prepare-tailcat.mjs",
    "build:browser": "node scripts/prepare-browser.mjs",
    "smoke:browser": "node scripts/smoke-browser-bundle.mjs",
    "smoke:launch": "node scripts/smoke-packaged-launch.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:updater": "node scripts/bundle-updater.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:companion && pnpm build:updater && pnpm build:android-tools && pnpm build:cloudflared && pnpm build:tailcat && pnpm build:browser && pnpm build:duckdb && pnpm check:no-phone-home",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm package:prepare && pnpm build:cua:win && electron-builder --win --publish never",
    "package:fork:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:cua && node scripts/package-fork.mjs mac",
    "package:fork:win": "pnpm package:prepare && pnpm build:cua:win && node scripts/package-fork.mjs win",
    "package:fork:win:cross": "pnpm package:prepare && node scripts/prepare-win-cross.mjs && node scripts/package-fork.mjs win",
    "package:linux": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux --x64 --publish never",
    "package:linux:offline": "pnpm package:prepare && pnpm build:cua:linux:offline && electron-builder --linux --x64 --publish never",
    "smoke:deb-command": "node scripts/smoke-deb-command.mjs",
    "smoke:linux-update": "xvfb-run -a electron --no-sandbox scripts/smoke-linux-update.mjs",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "control-plane:types": "pnpm --filter @sagax/control-plane types",
    "control-plane:check": "pnpm --filter @sagax/control-plane check",
    "control-plane:test": "pnpm --filter @sagax/control-plane test",
    "control-plane:dry-run": "pnpm --filter @sagax/control-plane dry-run",
    "icons:generate": "electron scripts/generate-app-icon.mjs",
    "build:duckdb": "node scripts/prepare-duckdb.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@duckdb/node-api": "1.5.6-r.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hpke/core": "1.9.0",
    "@jsquash/webp": "1.5.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@novnc/novnc": "1.7.0",
    "@resvg/resvg-js": "2.6.2",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@trycua/cua-driver": "0.33.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "croner": "10.0.1",
    "emojibase-data": "16.0.3",
    "hls.js": "^1.7.3",
    "jmespath": "0.16.0",
    "jose": "6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^1.51.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.1.0",
    "nodemailer": "^10.1.4",
    "onnxruntime-web": "1.30.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.3.289",
    "qrcode-terminal": "0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.10",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tar": "7.5.22",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "yaml": "^2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jmespath": "0.15.2",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/novnc__novnc": "1.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "knip": "6.44.1",
    "oxlint": "1.86.0",
    "playwright": "1.55.1",
    "tailwindcss": "^4.3.3",
    "typebox": "1.3.34",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "ws": "8.22.0"
  }
}
