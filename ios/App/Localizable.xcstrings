      }
    },
    "Record a few seconds of your voice once: the call then ignores other voices (a TV, a colleague). Your voiceprint stays on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez quelques secondes de votre voix une fois : l'appel ignore ensuite les autres voix (une télé, un collègue). Votre empreinte vocale reste sur cet appareil."
          }
        }
      }
    },
    "Keep talking, read anything aloud (%lld%%)": {
      "localizations": {
        "fr": {
