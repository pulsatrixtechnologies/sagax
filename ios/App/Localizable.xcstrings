    },
    "One bot owns and completes each run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One bot owns and completes each run."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bot prend en charge et termine chaque exécution."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bot assume e conclui cada execução."
          }
        }
      }
    },
    "One bot, set up for you: it picks the right engine and model on its own, and asks you before doing anything that leaves this computer. You can change all of it later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bot, configuré pour vous : il choisit lui-même le bon moteur et le bon modèle, et vous demande avant toute action qui sort de cet ordinateur. Vous pourrez tout changer plus tard."
          }
        }
      }
    },
    "One email or @company.com per line": {
      "localizations": {
