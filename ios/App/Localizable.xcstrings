            "state": "translated",
            "value": "Ce plugin n'est plus installé."
          }
        }
      }
    },
    "This proposal was created by an older build and cannot be safely applied. Deny it and ask the bot to create it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette proposition a été créée par une version antérieure et ne peut pas être appliquée en toute sécurité. Refuse-la et demande au bot de la recréer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta proposta foi criada por uma versão mais antiga e não pode ser aplicada com segurança. Negue e peça ao bot para criá-la de novo."
          }
        }
      }
    },
    "This provider cannot use saved command approvals. You can still remove existing rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider cannot use saved command approvals. You can still remove existing rules."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur ne peut pas utiliser les approbations de commandes enregistrées. Vous pouvez quand même retirer les règles existantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor não pode usar aprovações de comandos salvas. Você ainda pode remover as regras existentes."
          }
        }
      }
    },
    "This provider doesn't report a price; tokens are counted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider doesn't report a price; tokens are counted."
          }
