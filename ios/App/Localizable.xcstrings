    "macOS keeps texts in a protected folder that only Full Disk Access can open. Sagax uses it only to read Messages on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS keeps texts in a protected folder that only Full Disk Access can open. Sagax uses it only to read Messages on this Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS garde les textos dans un dossier protégé que seul l'accès complet au disque peut ouvrir. Sagax s'en sert seulement pour lire Messages sur ce Mac."
          }
        }
      }
    },
