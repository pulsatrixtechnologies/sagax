    },
    "Show a list of the shell commands a bot ran for your current request. Turn it off to hide the card and its shortcut for saving the run as a skill.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a list of the shell commands a bot ran for your current request. Turn it off to hide the card and its shortcut for saving the run as a skill."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la liste des commandes shell qu'un bot a exécutées pour votre demande en cours. Désactivez-la pour masquer la carte et son raccourci pour enregistrer l'exécution comme compétence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a lista dos comandos de shell que um bot executou para o seu pedido atual. Desative para ocultar o cartão e o atalho para salvar a execução como skill."
          }
        }
      }
    },
