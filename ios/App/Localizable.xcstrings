      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Pulsatrix if this AI-generated reply from %@ is harmful, offensive or wrong. The report is an email you send from your mail app, with only what you choose below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis à Pulsatrix si cette réponse générée par IA de %@ est nuisible, offensante ou fausse. Le signalement est un courriel que tu envoies de ton app de courriel, avec seulement ce que tu choisis ci-dessous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga à Pulsatrix se esta resposta gerada por IA de %@ é prejudicial, ofensiva ou errada. A denúncia é um e-mail que você envia do seu app de e-mail, só com o que você escolher abaixo."
          }
        }
      }
    },
    "That didn't work on my side. The details are in the chat.": {
