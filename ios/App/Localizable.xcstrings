    },
    "This bot gets no computer and no built-in browser, so it cannot open a web page, click, or type anywhere. Its connected apps, MCP servers, files and chat all still work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot gets no computer and no built-in browser, so it cannot open a web page, click, or type anywhere. Its connected apps, MCP servers, files and chat all still work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bot n'a ni ordinateur ni navigateur intégré : il ne peut ouvrir aucune page web, cliquer ni taper nulle part. Ses apps connectées, serveurs MCP, fichiers et la discussion fonctionnent toujours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bot não tem computador nem navegador integrado, então não pode abrir páginas, clicar nem digitar em lugar nenhum. Apps conectados, servidores MCP, arquivos e o chat continuam funcionando."
          }
        }
      }
    },
