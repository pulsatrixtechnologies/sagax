    "What the bot did each day, in its own words. Not loaded into conversations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the bot did each day, in its own words. Not loaded into conversations."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le bot a fait chaque jour, dans ses mots. Pas chargé dans les conversations."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o bot fez a cada dia, com as palavras dele. Não é carregado nas conversas."
          }
        }
      }
    },
    "Changes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes"
          }
        },
