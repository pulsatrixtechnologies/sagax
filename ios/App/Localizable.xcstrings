            "value": "Garde le navigateur intégré inaccessible à ce bot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o navegador integrado indisponível para este bot."
          }
        }
      }
    },
    "Keep the folder structure": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la structure des dossiers"
          }
