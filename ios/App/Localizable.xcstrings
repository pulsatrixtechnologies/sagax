    "You pay for %@'s replies to everyone who writes to it, and you don't have %@ access: connect your %@ subscription or add your key in Perspicax.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pay for %@'s replies to everyone who writes to it, and you don't have %@ access: connect your %@ subscription or add your key in Perspicax."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez les réponses de %1$@ pour tous ceux qui lui écrivent, et vous n'avez pas d'accès %2$@ : connectez votre abonnement %3$@ ou ajoutez votre clé dans Perspicax."
          }
        }
      }
    },
    "Replies from %@ are paid by the person who writes, and you don't have %@ access: connect your %@ subscription, add your key in Perspicax, or choose a model you can pay for.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies from %@ are paid by the person who writes, and you don't have %@ access: connect your %@ subscription, add your key in Perspicax, or choose a model you can pay for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses de %1$@ sont payées par la personne qui écrit, et vous n'avez pas d'accès %2$@ : connectez votre abonnement %3$@, ajoutez votre clé dans Perspicax ou choisissez un modèle que vous pouvez payer."
          }
        }
      }
    },
    "Replies from %@ are paid by the person who writes, and your organization has not given you %@ on its account: connect your own %@ subscription, add your key in Perspicax, or choose a model you can pay for.": {
      "localizations": {
