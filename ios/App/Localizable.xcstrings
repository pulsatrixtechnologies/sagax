          }
        }
      }
    },
    "A section can have one Chief. Go back and choose one Chief, or use a section without one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une section peut avoir un seul chef. Reviens en arrière et choisis un chef, ou utilise une section sans chef."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma seção pode ter um Chefe. Volte e escolha um Chefe, ou use uma seção sem nenhum."
          }
        }
      }
    },
    "A server's code is 12 letters and digits, never 0, O, 1 or I.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server's code is 12 letters and digits, never 0, O, 1 or I."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d'un serveur compte 12 lettres et chiffres, jamais 0, O, 1 ni I."
          }
        }
      }
    },
    "A shared Cua Linux sandbox on the computer for bots to browse and work in: isolated, backed by one durable folder, and stopped automatically after 10 minutes without use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared Cua Linux sandbox on the computer for bots to browse and work in: isolated, backed by one durable folder, and stopped automatically after 10 minutes without use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bac à sable Linux Cua partagé sur l'ordinateur où les bots naviguent et travaillent : isolé, adossé à un dossier durable et arrêté automatiquement après 10 minutes sans usage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sandbox Linux Cua compartilhado no computador para os bots navegarem e trabalharem: isolado, com uma pasta durável, e parado automaticamente após 10 minutos sem uso."
          }
        }
      }
    },
    "A shared brief every member sees on each turn. You can edit it later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared brief every member sees on each turn. You can edit it later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brief partagé que chaque membre voit à chaque tour. Vous pourrez le modifier plus tard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um briefing compartilhado que cada membro vê a cada turno. Dá para editar depois."
          }
        }
      }
    },
    "A shared file could not be sent: %@": {
