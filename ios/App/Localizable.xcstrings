    "On each due time, Sagax checks without any model turn and starts the run only on a change. At most one check every %lld min.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "On each due time, Sagax checks without any model turn and starts the run only on a change. At most one check every %lld min." } },
        "fr": { "stringUnit": { "state": "translated", "value": "À chaque échéance, Sagax vérifie sans aucun tour de modèle et ne lance l'exécution que s'il y a un changement. Au plus une vérification aux %lld min." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "On each due time, Sagax checks without any model turn and starts the run only on a change. At most one check every %lld min." } }
      }
