# Extra checks of scripts/fast-gate.sh: "<name>: <command>", FAST_GATE_FILES set.
#
# agents-proxy (#3406): server/drivers/agents-proxy.test.ts pins the tool list
# of the agents MCP server, its read annotations and some descriptions. The
# tools are defined and listed elsewhere (the catalog, agents-tools/, the
# agents-*-tools.ts files, the reviewed read list), so a lot that adds or
# rewords a tool there runs this file too.
agents-proxy: if printf '%s\n' "$FAST_GATE_FILES" | grep -qE '^server/(drivers/(agents-catalog[^/]*|agents-[^/]*-tools|agents-tools/[^/]*|agents-call[^/]*|agents-merged)|tools/agent-tool-policy)\.ts$'; then ./node_modules/.bin/vitest run --reporter=dot server/drivers/agents-proxy.test.ts; else echo "fast-gate: skip: no tool of the agents server touched"; fi

# agents-catalog (#4518): the tool list a bot is sent on every turn is
# measured against its ceiling (server/drivers/agents-catalog-budget.test.ts),
# its part a Claude turn loads up front is measured (agents-catalog-deferred),
# and it is pinned byte for byte (agents-catalog-wire.test.ts, a guard test)
# and by family (agents-merged.test.ts). A lot that adds tool text touches a
# definition, a shared schema or a profile that reaches those tests only
# through agents-catalog.ts, so three of them stayed red on main unseen. A
# lot that touches any file the catalog imports (CATALOG_ROOTS and their
# imports, CATALOG_TESTS, in scripts/verify/release/guard-tests.mjs) runs
# them, and the widget tool texts agents-call-cards.test.ts pins. About 25 s.
agents-catalog: G="$(node scripts/verify/release/guard-tests.mjs --catalog --touched)"; case "$G" in skip:*) echo "fast-gate: $G" ;; *) ./node_modules/.bin/vitest run --reporter=dot $G ;; esac

# index-reach (#3477): the reach rule lives in server/peers/ and is enforced by
# the routine, room and bot-chat routes, but its end-to-end cases sit in
# server/index.test.ts, which the stem rule runs only when server/index.ts
# itself is touched. A lot that changes the rule runs that part of the file
# (the cases about teammates, sections, peers and Primary Bots, about 20 s),
# not the whole file; when server/index.ts or its test is touched the tests
# check already runs all of it.
index-reach: if printf '%s\n' "$FAST_GATE_FILES" | grep -qE '^server/index(\.test)?\.ts$'; then echo "fast-gate: skip: the tests check runs all of server/index.test.ts"; elif printf '%s\n' "$FAST_GATE_FILES" | grep -qE '^server/(peers/[^/]*|routines/routine-requests[^/]*|routes/internal-(requests|rooms|bot-chat)[^/]*|index-leaves/[^/]*)\.ts$'; then ./node_modules/.bin/vitest run --reporter=dot server/index.test.ts -t 'teammate|targeted|section|peer|another person|Chief|Primary Bot|reach'; else echo "fast-gate: skip: no file of the reach rule touched"; fi

# full-access-guard (#3508): server/approvals/full-access-gate.guard.test.ts
# scans the whole server for the cards a person may have to answer and fails
# one with no `// full-access: <surface>` marker. The stem rule never runs it
# for a new emitter elsewhere, so a lot that touches server/approvals/,
# server/harness/ or any server file that emits a card (an options row, a
# permission request, a peer card, a safety hold, ask_choice, a browser held
# card) runs it. It only reads files: a second or two.
full-access-guard: if printf '%s\n' "$FAST_GATE_FILES" | grep -qE '^server/(approvals|harness)/[^[:space:]]*\.ts$' || printf '%s\n' "$FAST_GATE_FILES" | grep -E '^server/[^[:space:]]*\.ts$' | grep -vE '\.(test|e2e)\.ts$' | while IFS= read -r f; do [ -f "$f" ] && grep -lqE 'kind: "options",|requestType: "permission"|requestPeerApproval\(|safety(PermissionEffect|ToolHold)\(|createChoiceCard\(|deps\.confirm\(' "$f" && echo hit; done | grep -q hit; then ./node_modules/.bin/vitest run --reporter=dot server/approvals/full-access-gate.guard.test.ts; else echo "fast-gate: skip: no card emitter of the server touched"; fi

# guard-tests (#3509): the guard tests of verify:merge (GUARD_TESTS in
# scripts/verify/release/guard-tests.mjs: ratchets, goldens, source scans)
# run on every lot, whatever it touches. They catch what the last merge broke
# for everyone (a route with no policy row, a locale key nothing reads, a card
# that skips the settings decision); left to the files beside a change, main
# stayed red unseen. About 95 s together (#3538 added two files, about 15 s;
# #4131 the UI guards that scan the whole of src, about 25 s). The
# source-text tests of the same list have their own line below.
guard-tests: G="$(node scripts/verify/release/guard-tests.mjs)"; if [ -n "$G" ]; then ./node_modules/.bin/vitest run --reporter=dot --testTimeout=60000 $G; fi

# electron-unit (#3565): the Electron unit tests (electron/*.node-test.mjs,
# node --test, not vitest) ran nowhere but the full CI run, so two of the
# desktop bridge's guard tests stayed red on main unseen (the bundled page
# getting the full screen frame). They break from changes outside electron/
# too (shared/, server/testing/), so they run on every lot, whatever it
# touches: about 15 s together (45 s on a busy machine).
electron-unit: node --test "electron/*.node-test.mjs"

# shared-cycles (#4164): the import cycle ceiling of shared/
# (scripts/testing/madge-cycles.guard.test.ts, at zero) went red on main
# unseen: two lots each added a type import that closed a cycle in shared/
# (#3541, #4149), and only a lot that touched the guard itself ran it. Only a
# change in shared/ can add a cycle there, so a lot that touches a TypeScript
# file of shared/ runs that one case: about 10 s on a busy machine. The src
# and server cases wait on the cycles they still hold (known failures).
shared-cycles: if printf '%s\n' "$FAST_GATE_FILES" | grep -qE '^shared/[^[:space:]]*\.tsx?$'; then ./node_modules/.bin/vitest run --reporter=dot scripts/testing/madge-cycles.guard.test.ts -t 'shared stays at its ceiling'; else echo "fast-gate: skip: no TypeScript file of shared/ touched"; fi

# source-text (#4186): the tests that read the app's sources or its locale
# catalogs as text (SOURCE_TEXT_TESTS in scripts/verify/release/guard-tests.mjs)
# are linked to nothing by the import graph, so eight of them went red on the
# 0.8.100 release commit unseen (a renamed window, a restyled round button).
# They read src/, the catalogs, the iPad wording map, the model providers
# docs page and two scripts/testing files (SOURCE_TEXT_READS, same file), so a
# lot that touches one of those runs them all. They are static scans and
# rendered markup with no server, so they run two files at a time: about 75 s
# on a busy machine (240 s one at a time).
source-text: G="$(node scripts/verify/release/guard-tests.mjs --source-text --touched)"; if [ -n "$G" ]; then ./node_modules/.bin/vitest run --reporter=dot --fileParallelism --maxWorkers=2 --testTimeout=60000 $G; else echo "fast-gate: skip: no file the source-text tests read touched"; fi

# parity-pairs (#4305, #4320, #4316): the text-level tests that hold one side
# of a pair to the other (PARITY_PAIRS in scripts/verify/release/guard-tests.mjs):
# the phone's trigger kinds and sources (the list the Swift package test
# ParityR1TriggersTests pins after a merge), the phone and tablet wording, the
# phone's theme tokens, and the hooks the real-renderer smokes select. A
# desktop change already runs them through the source-text line; this line
# adds the other side: a lot that touches only the phone's, the tablet's or a
# smoke's files runs the pair's test too. A second or two each.
parity-pairs: G="$(node scripts/verify/release/guard-tests.mjs --parity --touched)"; case "$G" in skip:*) echo "fast-gate: $G" ;; *) ./node_modules/.bin/vitest run --reporter=dot $G ;; esac
