            "value": "Continuez d'explorer pour le trouver."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue explorando para encontrá-la."
          }
        }
      }
    },
    "Keep notifications on screen": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les notifications à l'écran"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as notificações na tela"
          }
        }
      }
    },
    "Keep one scheduled run waiting until this routine finishes. Skip further occurrences until it starts. Manual runs are separate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep one scheduled run waiting until this routine finishes. Skip further occurrences until it starts. Manual runs are separate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder une exécution planifiée en attente jusqu’à la fin de cette routine. Les occurrences suivantes sont sautées jusqu’à son début. Les exécutions manuelles sont à part."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter uma execução agendada aguardando até esta rotina terminar. As ocorrências seguintes são puladas até ela começar. Execuções manuais são separadas."
          }
        }
      }
    },
    "Keep prompt cache warm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le cache de prompt chaud"
          }
        }
      }
    },
    "Keep related threads together under %@. Moving a thread never changes its model, permissions, or conversation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep related threads together under %@. Moving a thread never changes its model, permissions, or conversation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les fils liés sous %@. Déplacer un fil ne change jamais son modèle, ses permissions ni sa conversation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as threads relacionadas juntas em %@. Mover uma thread nunca muda o modelo, as permissões ou a conversa."
          }
        }
      }
    },
    "Keep talking, read anything aloud (%lld%%)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez de parler, lisez n'importe quoi à voix haute (%lld %%)"
