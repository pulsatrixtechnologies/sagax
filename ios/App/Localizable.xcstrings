    "Private Cua Linux desktops on the computer, with one container and durable folder per bot. Distinct bots can work concurrently and unused desktops stop after 10 minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cua Linux desktops on the computer, with one container and durable folder per bot. Distinct bots can work concurrently and unused desktops stop after 10 minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des bureaux Linux Cua privés sur l'ordinateur, avec un conteneur et un dossier durable par bot. Plusieurs bots peuvent travailler en même temps et les bureaux inutilisés s'arrêtent après 10 minutes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktops Linux Cua privados no computador, com um contêiner e uma pasta durável por bot. Bots diferentes podem trabalhar ao mesmo tempo e desktops sem uso param após 10 minutos."
          }
        }
      }
    },
