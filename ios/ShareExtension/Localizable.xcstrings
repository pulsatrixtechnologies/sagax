            "value": "Enviando %lld%%"
          }
        }
      }
    },
    "A shared file could not be sent: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared file could not be sent: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier partagé n'a pas pu être envoyé : %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar um arquivo compartilhado: %@"
          }
        }
      }
    },
    "Sagax is already sending this share. You can close this sheet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax is already sending this share. You can close this sheet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax envoie déjà ce partage. Vous pouvez fermer cette fenêtre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sagax já está enviando este compartilhamento. Você pode fechar esta janela."
