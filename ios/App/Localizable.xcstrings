          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur de l'organisation peut modifier le dossier de travail."
          }
        }
      }
    },
    "Only continue on a network you trust. Local connections are authenticated but are not encrypted by Sagax.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue seulement sur un réseau de confiance. Les connexions locales sont authentifiées, mais Sagax ne les chiffre pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só continue em uma rede em que você confia. As conexões locais são autenticadas, mas não são criptografadas pelo Sagax."
          }
        }
      }
    },
    "Only continue on a network you trust. Local connections are authenticated but not encrypted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
