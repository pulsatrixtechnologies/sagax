    "Replace the existing Local VM with the pinned image and safety limits? Files and browser sign-ins in its durable folder will remain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the existing Local VM with the pinned image and safety limits? Files and browser sign-ins in its durable folder will remain."
