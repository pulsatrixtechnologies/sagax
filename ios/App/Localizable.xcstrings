          }
        }
      }
    },
    "Your organization's Perspicax must be updated before the photo can be changed from Sagax.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Perspicax de votre organisation doit être mis à jour avant de pouvoir changer la photo depuis Sagax."
