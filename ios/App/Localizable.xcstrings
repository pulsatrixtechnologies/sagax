    },
    "A bot is working on this computer. Reset anyway? Its current task is cut short and the computer is rebuilt from the last snapshot. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bot is working on this computer. Reset anyway? Its current task is cut short and the computer is rebuilt from the last snapshot. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bot travaille sur cet ordinateur. Réinitialiser quand même ? Sa tâche en cours est coupée et l'ordinateur est reconstruit à partir du dernier instantané. C'est irréversible."
          }
        }
      }
    },
