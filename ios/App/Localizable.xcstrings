          }
        }
      }
    },
    "The bot keeps using the saved version until you choose. File:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot continue d'utiliser la version enregistrée tant que vous ne choisissez pas. Fichier :"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot continua usando a versão salva até você escolher. Arquivo:"
          }
        }
      }
    },
    "The bot never sees the card number or the security code. Nothing is charged until you allow it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bot never sees the card number or the security code. Nothing is charged until you allow it."
