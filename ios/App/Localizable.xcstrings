    },
    "For groups and new threads. Also updates the selected idle thread; other existing threads keep their model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For groups and new threads. Also updates the selected idle thread; other existing threads keep their model."
          }
