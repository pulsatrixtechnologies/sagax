{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "page-reader.html",
    "src/main.tsx",
    "src/page-reader/**/*.{ts,tsx}",
    "src/gallery/**/*.{html,ts,tsx}",
    "src/testing/**/*.{ts,tsx}",
    "electron/fixtures/**/*.{cjs,js,mjs}",
    "server/dev-server.ts",
    "server/runtime/**/*.ts",
    "server/health-scan.ts",
    "server/index.ts",
    "server/early-listener.ts",
    "server/message-search.worker.ts",
    "server/webp-scale.worker.ts",
    "server/openmausbot.ts",
    "server/pair-cli.ts",
    "server/workspace-backup.worker.ts",
    "server/server-launcher.ts",
    "server/proxy-paths.ts",
    "server/local-computer.ts",
    "server/local-computer-proxy.ts",
    "server/hooks/omb-hook.ts",
    "server/container-mcp.ts",
    "server/vps-container-mcp.ts",
    "server/permission-proxy.ts",
    "server/perspicax-mcp-bridge.ts",
    "server/mcp-gate.ts",
    "server/mcp-remote-proxy.ts",
    "server/harness-mcp-proxy.ts",
    "server/user-sandbox-proxy.ts",
    "server/sandboxd.ts",
    "server/sagax-runner.ts",
    "server/drivers/agents-proxy.ts",
    "server/drivers/dweb-proxy.ts",
    "server/drivers/phone-proxy.ts",
    "server/drivers/imessage-proxy.ts",
    "server/testing/**/*.{ts,mjs,js}",
    "electron/main.mjs",
    "electron/*preload*.cjs",
    "electron/*main*.mjs",
    "electron/*.node-test.mjs",
    "companion/src/**/*.ts",
    "scripts/**/*.{mjs,ts,js}",
    "evals/**/*.{ts,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "server/**/*.{ts,mjs,js}",
    "electron/**/*.{ts,mjs,js,cjs,mts}",
    "shared/**/*.{ts,tsx}",
    "companion/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts,js}",
    "evals/**/*.{ts,mjs}"
  ],
  "ignore": [
    "ios/**",
    "android/**",
    "third_party/**",
    "apps/**",
    "dist*/**",
    // #3031: imported only inside a string fixture of scripts/verify/dev/verify-organization-settings.mjs (branding=1), invisible to knip.
    "src/components/OrganizationIdentity.tsx",
    "src/lib/use-organization-branding.ts",
    "release/**",
    "deploy/**",
    "**/*.d.mts",
    "**/*.d.ts"
  ],
  "ignoreBinaries": [
    "xvfb-run",
    "electron-builder",
    "swift",
    "xcodebuild",
    "podman",
    "docker"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
    "enumMembers": "off",
    "namespaceMembers": "off"
  }
}
