            "state": "translated",
            "value": "Group memory"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire du groupe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória do grupo"
          }
        }
      }
    },
    "Notes every bot of this group reads at each turn here, and writes when it learns something the whole group should keep. A bot's own memory stays private and never lands here on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes every bot of this group reads at each turn here, and writes when it learns something the whole group should keep. A bot's own memory stays private and never lands here on its own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes que chaque bot de ce groupe lit à chaque tour ici, et qu'il complète quand il apprend quelque chose que tout le groupe doit garder. La mémoire propre d'un bot reste privée et n'arrive jamais ici d'elle-même."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas que cada bot deste grupo lê a cada turno aqui, e escreve quando aprende algo que o grupo todo deve guardar. A memória própria de um bot continua privada e nunca vem parar aqui sozinha."
          }
        }
      }
    },
    "Let the bots of this group use its memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the bots of this group use its memory"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser les bots de ce groupe utiliser sa mémoire"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar os bots deste grupo usarem a memória dele"
          }
        }
      }
    },
    "Only the owner of this group can change its memory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the owner of this group can change its memory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire de ce groupe peut modifier sa mémoire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o dono deste grupo pode alterar a memória dele."
          }
        }
      }
    },
    "Off: the bots neither read nor write it. The notes stay here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: the bots neither read nor write it. The notes stay here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée : les bots ne la lisent ni ne l'écrivent. Les notes restent ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligada: os bots não a leem nem escrevem. As notas ficam aqui."
          }
        }
      }
    },
    "- A fact the whole group should keep": {
      "localizations": {
        "en": {
