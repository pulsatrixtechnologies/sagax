        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido desde %@, renovado em %@"
          }
        }
      }
    },
    "Allowed by default. Perspicax confirms it after your first routine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed by default. Perspicax confirms it after your first routine."
