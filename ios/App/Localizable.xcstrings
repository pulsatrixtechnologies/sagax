        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre bot principal : il peut agir sur vos autres bots pour vous."
          }
        }
      }
    },
    "This is your primary bot, your main contact. It coordinates your other bots and specialists (home team: %@), then combines their work into one answer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your primary bot, your main contact. It coordinates your other bots and specialists (home team: %@), then combines their work into one answer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre bot principal, votre contact principal. Il coordonne vos autres bots et spécialistes (équipe d'attache : %@), puis réunit leur travail en une seule réponse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu bot principal, o seu contato principal. Ele coordena seus outros bots e especialistas (equipe de origem: %@) e depois junta o trabalho deles em uma só resposta."
