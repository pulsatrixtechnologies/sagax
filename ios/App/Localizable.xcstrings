    "Replaces current SOUL with the version before this change. Current version stays in History.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces current SOUL with the version before this change. Current version stays in History."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le SOUL actuel par la version d'avant ce changement. La version actuelle reste dans l'historique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o SOUL atual pela versão anterior a esta alteração. A versão atual fica no histórico."
          }
        }
      }
    },
    "Replaces everything here, once the file is checked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace tout ici, une fois le fichier vérifié."
          }
        }
      }
    },
    "Replaces them in the final text of bot replies: a range word between times and numbers, a colon after a list label, a comma elsewhere. On by default in French.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplace dans le texte final des réponses des bots : « à » entre deux heures ou deux nombres, deux-points après un libellé de liste, virgule ailleurs. Actif par défaut en français."
          }
        }
      }
    },
    "Replays a rule on what your bots really did, without saving it or changing anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replays a rule on what your bots really did, without saving it or changing anything."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoue une règle sur ce que vos bots ont vraiment fait, sans l'enregistrer ni rien changer."
          }
        }
      }
    },
    "Replies from %@ are paid by the person who writes, and you don't have %@ access: connect your %@ subscription, add your key in Perspicax, or choose a model you can pay for.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies from %@ are paid by the person who writes, and you don't have %@ access: connect your %@ subscription, add your key in Perspicax, or choose a model you can pay for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses de %1$@ sont payées par la personne qui écrit, et vous n'avez pas d'accès %2$@ : connectez votre abonnement %3$@, ajoutez votre clé dans Perspicax ou choisissez un modèle que vous pouvez payer."
          }
        }
      }
    },
    "Replies from %@ are paid by the person who writes, and your organization has not given you %@ on its account: connect your own %@ subscription, add your key in Perspicax, or choose a model you can pay for.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies from %@ are paid by the person who writes, and your organization has not given you %@ on its account: connect your own %@ subscription, add your key in Perspicax, or choose a model you can pay for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses de %1$@ sont payées par la personne qui écrit, et votre organisation ne vous a pas donné %2$@ sur son compte : connectez votre propre abonnement %3$@, ajoutez votre clé dans Perspicax ou choisissez un modèle que vous pouvez payer."
          }
        }
      }
    },
