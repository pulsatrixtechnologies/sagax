    },
    "Auto mode will let this bot click, type, and run tools on this computer without asking first. Destructive and sensitive actions still stop. Continue only if you are watching.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Auto laisse ce bot cliquer, taper et lancer des outils sur cet ordinateur sans demander d'abord. Les actions destructrices et sensibles s'arrêtent encore. Continuez seulement si vous regardez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Auto deixa este bot clicar, digitar e executar ferramentas neste computador sem perguntar antes. Ações destrutivas e sensíveis ainda param. Continue só se você estiver olhando."
          }
        }
      }
    },
