        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot e suas conversas serão excluídos. Isso não pode ser desfeito."
          }
        }
      }
    },
    "The bot could not be created. Try again.": {
      "localizations": {
        "fr": {
