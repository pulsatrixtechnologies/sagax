    "Each run starts with the previous run's report, so the bot knows what it found last time. Good for checks like QA or monitoring.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Each run starts with the previous run's report, so the bot knows what it found last time. Good for checks like QA or monitoring." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Chaque exécution commence par le compte rendu de la précédente, pour que le bot sache ce qu'il a trouvé la dernière fois. Utile pour des vérifications comme l'assurance qualité ou la surveillance." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Cada execução começa com o relatório da anterior, para que o bot saiba o que encontrou da última vez. Bom para verificações como QA ou monitoramento." } }
      }
    },
