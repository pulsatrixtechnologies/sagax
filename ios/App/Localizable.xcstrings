    },
    "Your primary bot is your main contact: it coordinates your other bots.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your primary bot is your main contact: it coordinates your other bots."
          }
        },
        "fr": {
