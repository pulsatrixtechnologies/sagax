            "value": "Lit seulement des données. Rien ne change."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só lê dados. Nada muda."
          }
        }
      }
    },
    "Only restore backups you trust: instructions, skills, and bot permissions are restored too. Reconnect accounts as needed. Routines, webhooks, and calendar calls arrive paused; pending work is not resumed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne restaurez que des sauvegardes de confiance : instructions, compétences et permissions des bots sont aussi restaurées. Routines, webhooks et appels arrivent en pause."
          }
        }
      }
    },
    "Only the bot's owner, or someone who manages it, can change its plugins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the bot's owner, or someone who manages it, can change its plugins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire du robot, ou une personne qui le gère, peut modifier ses plugins."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o dono do bot, ou alguém que o gerencia, pode alterar os plugins dele."
          }
        }
