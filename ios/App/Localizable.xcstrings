    "Your computer is waking. If it does not come back on its own, recover it. Files stay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your computer is waking. If it does not come back on its own, recover it. Files stay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur se réveille. S'il ne revient pas de lui-même, récupérez-le. Les fichiers restent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu computador está acordando. Se ele não voltar sozinho, recupere-o. Os arquivos ficam."
          }
        }
      }
    },
    "If it does not come back on its own, recover it. Files stay. Installed apps and packages are removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it does not come back on its own, recover it. Files stay. Installed apps and packages are removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il ne revient pas de lui-même, récupérez-le. Les fichiers restent. Les applications et les paquets installés sont retirés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ele não voltar sozinho, recupere-o. Os arquivos ficam. Os aplicativos e pacotes instalados são removidos."
          }
        }
      }
    },
