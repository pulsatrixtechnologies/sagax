    },
    "Optional: apps, MCP servers, the computer and the browser. By default the Workspace is on Auto, no MCP server is used, and apps connect later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: apps, MCP servers, the computer and the browser. By default the Workspace is on Auto, no MCP server is used, and apps connect later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionnel : les apps, les serveurs MCP, l'ordinateur et le navigateur. Par défaut, l'espace de travail est sur Auto, aucun serveur MCP n'est utilisé et les apps se connectent plus tard."
          }
        }
      }
    },
