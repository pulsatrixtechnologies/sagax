          }
        }
      }
    },
    "Your bots keep working on your computer or your organization's server. Follow them, answer their questions and send them work from here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bots keep working on your computer or your organization's server. Follow them, answer their questions and send them work from here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos robots travaillent sur votre ordinateur ou sur le serveur de votre organisation. Suivez-les, répondez à leurs questions et confiez-leur du travail d'ici."
          }
        }
      }
    },
    "Your bots stop using it in your conversations and routines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
