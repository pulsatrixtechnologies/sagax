    "People of your organization see a green, amber or grey dot on your picture. Off: you appear offline to everyone, with no last-seen time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People of your organization see a green, amber or grey dot on your picture. Off: you appear offline to everyone, with no last-seen time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes de votre organisation voient un point vert, ambre ou gris sur votre photo. Désactivé : vous paraissez hors ligne pour tout le monde, sans heure de dernière présence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas da sua organização veem um ponto verde, âmbar ou cinza na sua foto. Desativado: você aparece offline para todos, sem horário de última presença."
          }
        }
      }
    },
