#!/bin/sh
# Runs before every push: the local merge gate, scripts/verify/release/verify-merge.mjs
# (`pnpm verify:merge`). No CI runs on a private PR, so this is the barrier:
# lint, typecheck, locale catalogs, source terms, skin contrast, the guard
# tests that break main silently (ratchets, goldens, source scans), the
# tests beside the files of the diff, and iOS when ios/ or shared/ changed
# (skipped, and said so in the summary and the PR report, only when the swift
# binary is missing; any other probe failure fails the gate: the Swift tests then run after the merge).
# A few minutes. The full suite is deliberately NOT here: it runs once, at
# the version cut.
#
# Under nice, through a one-at-a-time, first come first served queue (mkdir
# lock and waiter tickets in the common git dir), and with every GIT_* the hook inherited stripped so a test cannot
# commit into the branch being pushed via a leaked GIT_DIR (issue #1705).
# Skips at once, before taking a ticket or the lock, when a verify:merge OK
# stamp already exists for this HEAD sha or for every commit the push sends
# (read from the hook's stdin, tags peeled; #4392); the check runs again after
# the wait, in case another agent stamped the sha meanwhile. The
# stamp means HEAD itself (#3684): verify-merge.mjs takes the diff from the
# commit and refuses while a tracked file differs from HEAD or the diff imports
# an untracked file; ignored files and untracked scratch files never block.
#
# Only a stamp verify-merge.mjs wrote counts (its first line is "ok <time>"),
# #4316: a landing step that ran typecheck, lint and terms alone also left an
# ok-<sha> file, empty, and the hook skipped every test, so a lot whose own
# tests were red (#4354, #4356) still landed. On such a stamp the lint side is
# done, so the hook runs the test side of the fast gate against the base
# (scripts/fast-gate.sh --only tests,related,extra-source-text,extra-parity-pairs):
# the tests of the touched files, the tests that reach them through imports,
# the source-text tests and the parity pairs. Without a stamp it runs
# verify:merge as before.
#
# Installed by `pnpm install` through scripts/install-git-hooks.mjs (sets
# core.hooksPath). Skip once with `git push --no-verify`, or for a session
# with SAGAX_SKIP_HOOKS=1.
set -e
# (the old name, OMB_SKIP_HOOKS, still works for one release)
if [ -n "$SAGAX_SKIP_HOOKS$OMB_SKIP_HOOKS" ]; then
  echo "pre-push: skipped (SAGAX_SKIP_HOOKS is set)"
  exit 0
fi

# Resolve paths while the hook's git env (GIT_DIR, …) is still intact.
ROOT="$(git rev-parse --show-toplevel)"
SHA="$(git rev-parse HEAD)"
SHA_SHORT="$(git rev-parse --short HEAD)"
COMMON="$(git rev-parse --git-common-dir)"
case "$COMMON" in
  /*) ;;
  *) COMMON="$ROOT/$COMMON" ;;
esac
STAMP_DIR="$COMMON/sagax-verify-merge"
STAMP="$STAMP_DIR/ok-$SHA"
LOCK_DIR="$STAMP_DIR/queue.lock"

# The commits this push sends (#4392): git feeds one line per ref on stdin,
# "<local ref> <local sha> <remote ref> <remote sha>". A tag is peeled to its
# commit; a deleted ref (all-zero sha) sends nothing.
PUSHED=""
if [ ! -t 0 ]; then
  while read -r _lref lsha _rref _rsha; do
    case "$lsha" in
      "" | *[!0]*) ;;
      *) continue ;;
    esac
    [ -n "$lsha" ] || continue
    c="$(git rev-parse --verify -q "$lsha^{commit}" 2>/dev/null)" || c="$lsha"
    PUSHED="$PUSHED $c"
  done
fi

# A stamp verify-merge.mjs wrote: its first line is "ok <time>".
ok_stamp() {
  [ -f "$STAMP_DIR/ok-$1" ] && head -n 1 "$STAMP_DIR/ok-$1" | grep -q '^ok '
}
# HEAD is verified, or every pushed commit is (a release tag whose commit the
# cut verified, a re-push of a verified commit, from any checkout).
verified_stamp() {
  ok_stamp "$SHA" && return 0
  [ -n "$PUSHED" ] || return 1
  for c in $PUSHED; do
    ok_stamp "$c" || return 1
  done
  SHA_SHORT="$(git rev-parse --short $PUSHED | tr '\n' ' ' | sed 's/ $//')"
}
# Before the ticket and the lock: a verified commit never waits in line.
if verified_stamp; then
  echo "pre-push: verify:merge already OK for $SHA_SHORT (stamp)"
  exit 0
fi

# Drop every GIT_* the hook inherited so child tests that run git see the
# working tree from cwd, not the worktree's GIT_DIR (githooks export it).
# Names only (awk), then unset: values may contain spaces.
git_vars="$(env | awk -F= '/^GIT_/ { print $1 }')"
for name in $git_vars; do
  unset "$name" || true
done

cd "$ROOT"
mkdir -p "$STAMP_DIR"

TICKET_DIR="$STAMP_DIR/queue.tickets"
mkdir -p "$TICKET_DIR"

# One verify:merge at a time across worktrees of this repo (agents saturate
# the machine otherwise). mkdir is atomic; a dead holder is cleared.
# First come, first served (#4377): each waiter leaves a ticket named
# <arrival second>-<pid> and tries the lock only while its ticket is the
# oldest one whose process is alive; dead waiters' tickets are dropped. A hook
# of an older checkout (no ticket) still races for the lock and wins or waits.
TICKET="$(printf '%010d' "$(date +%s)")-$$"
: >"$TICKET_DIR/$TICKET"
HOLDING=""
leave_queue() {
  rm -f "$TICKET_DIR/$TICKET"
  if [ -n "$HOLDING" ]; then rm -rf "$LOCK_DIR"; fi
}
trap leave_queue EXIT
trap 'exit 1' INT TERM HUP

# Sets pos: 1 + the live tickets older than ours.
queue_position() {
  pos=1
  [ -f "$TICKET_DIR/$TICKET" ] || : >"$TICKET_DIR/$TICKET"
  for t in $(ls "$TICKET_DIR" 2>/dev/null | LC_ALL=C sort -t- -k1,1n -k2,2n); do
    [ "$t" = "$TICKET" ] && return 0
    if kill -0 "${t#*-}" 2>/dev/null; then
      pos=$((pos + 1))
    else
      rm -f "$TICKET_DIR/$t"
    fi
  done
}

start="$(date +%s)"
shown=""
while :; do
  queue_position
  if [ "$pos" -eq 1 ] && mkdir "$LOCK_DIR" 2>/dev/null; then
    break
  fi
  if [ -f "$LOCK_DIR/pid" ]; then
    old="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [ -n "$old" ] && ! kill -0 "$old" 2>/dev/null; then
      echo "pre-push: removing stale verify:merge lock (pid $old)"
      rm -rf "$LOCK_DIR"
      continue
    fi
  fi
  if [ "$pos" != "$shown" ]; then
    echo "pre-push: waiting for another verify:merge (queue position $pos)"
    shown="$pos"
  fi
  if [ $(($(date +%s) - start)) -gt 7200 ]; then
    echo "pre-push: timed out waiting for verify:merge queue" >&2
    exit 1
  fi
  sleep 1
done
HOLDING=1
echo "$$" >"$LOCK_DIR/pid"
rm -f "$TICKET_DIR/$TICKET"

# Another agent may have stamped this sha while we waited.
if verified_stamp; then
  echo "pre-push: verify:merge already OK for $SHA_SHORT (stamp after queue)"
  exit 0
fi

# Gate the diff against the branch's real base: SAGAX_VERIFY_BASE, else the
# candidate (origin/main or an origin/feat/next-*) with the fewest commits of
# HEAD not on it. Against origin/main a release-train branch drags hundreds of
# unrelated test files and the queue times out.
BASE="${SAGAX_VERIFY_BASE:-}"
if [ -z "$BASE" ]; then
  best=""
  for ref in origin/main $(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/feat/next-*'); do
    n="$(git rev-list --count "$ref..HEAD" 2>/dev/null)" || continue
    if [ -z "$best" ] || [ "$n" -lt "$best" ]; then
      best="$n"
      BASE="$ref"
    fi
  done
fi
BASE="${BASE:-origin/main}"
if [ -f "$STAMP" ]; then
  TEST_SIDE="tests,related,extra-source-text,extra-parity-pairs"
  echo "pre-push: the stamp for $SHA_SHORT is not verify:merge's (no tests ran): nice -n 19 scripts/fast-gate.sh --base $BASE --only $TEST_SIDE"
  if command -v nice >/dev/null 2>&1; then
    nice -n 19 bash "$ROOT/scripts/fast-gate.sh" --base "$BASE" --only "$TEST_SIDE"
  else
    bash "$ROOT/scripts/fast-gate.sh" --base "$BASE" --only "$TEST_SIDE"
  fi
  exit 0
fi
echo "pre-push: nice -n 19 pnpm verify:merge --base $BASE (git push --no-verify to skip)"
if command -v nice >/dev/null 2>&1; then
  nice -n 19 pnpm verify:merge --base "$BASE"
else
  pnpm verify:merge --base "$BASE"
fi
# Stamp is written by verify-merge.mjs on OK (shared across worktrees).
