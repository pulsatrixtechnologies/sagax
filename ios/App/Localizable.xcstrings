          }
        }
      }
    },
    "Your organization turned off public links: this page is shown only to people signed in to this server until links are allowed again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organization turned off public links: this page is shown only to people signed in to this server until links are allowed again."
          }
