          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps un bot peut travailler dans cette conversation avant que le tour s'arrête. Par défaut utilise la limite de tour des groupes dans les Réglages. Un nouveau choix s'applique au prochain tour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo um bot pode trabalhar nesta conversa antes de o turno parar. Padrão usa o limite de turno dos grupos nos Ajustes. Uma nova escolha vale para o próximo turno."
          }
        }
      }
    },
