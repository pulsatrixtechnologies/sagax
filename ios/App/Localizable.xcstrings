          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dono deste bot está desativado: as rotinas dele não podem rodar."
          }
        }
      }
    },
    "This changes something on your phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes something on your phone."
          }
        },
