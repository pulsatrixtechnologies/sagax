          }
        }
      }
    },
    "Your bots, conversations and saved settings on this server are deleted with it. This can't be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bots, conversations and saved settings on this server are deleted with it. This can't be undone."
