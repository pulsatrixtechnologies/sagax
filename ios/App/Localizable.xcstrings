    "Idle Claude threads with a big context get one cache read every 50 minutes for the window set in Settings → Models.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fils Claude inactifs avec un gros contexte reçoivent une lecture de cache toutes les 50 minutes pour la fenêtre réglée dans Réglages → Modèles."
          }
        }
      }
    },
    "If an ACP model provider (such as Qwen or OpenCode) fails before starting, try a backup once. Work that may have already run is not replayed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an ACP model provider (such as Qwen or OpenCode) fails before starting, try a backup once. Work that may have already run is not replayed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un fournisseur ACP (comme Qwen ou OpenCode) échoue avant de démarrer, Sagax tente une relève une fois. Le travail déjà fait n'est pas rejoué."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um provedor ACP (como Qwen ou OpenCode) falhar antes de começar, tentar um reserva uma vez. O trabalho que já rodou não é repetido."
          }
        }
      }
    },
    "If it does not come back on its own, recover it. Files stay. Installed apps and packages are removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it does not come back on its own, recover it. Files stay. Installed apps and packages are removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il ne revient pas de lui-même, récupérez-le. Les fichiers restent. Les applications et les paquets installés sont retirés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ele não voltar sozinho, recupere-o. Os arquivos ficam. Os aplicativos e pacotes instalados são removidos."
          }
        }
      }
    },
