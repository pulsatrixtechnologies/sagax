# Optional all-Podman self-hosting image; the existing Dockerfile is unchanged.
# Build both server and renderer from this checkout, never mix release artifacts.
FROM node:24.21.0-trixie-slim AS build
WORKDIR /src
RUN npm install -g pnpm@10.34.6
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/docs/package.json ./apps/docs/package.json
RUN pnpm install --frozen-lockfile
COPY . .
# The native modules the bundle cannot hold (DuckDB, resvg; server/data/engine.ts),
# staged for this image's one architecture at the path the runtime stage copies.
RUN node --input-type=module -e "import { stageDuckdb } from './scripts/prepare-duckdb.mjs'; await stageDuckdb({ root: process.cwd(), targets: [{ platform: 'linux', arch: 'x64' }] });" \
  && chmod -R go-w dist-native/duckdb
RUN pnpm build:server && pnpm exec vite build

FROM node:24.21.0-trixie-slim
RUN test "$(uname -m)" = x86_64 \
    || { echo 'The Podman self-hosting image currently requires Linux x86_64.' >&2; exit 1; }
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1001 --create-home --home-dir /data --shell /bin/bash maus
# Only the remote client runs here. The engine and desktop containers are siblings.
RUN curl -fsSL https://github.com/podman-container-tools/podman/releases/download/v5.8.8/podman-remote-static-linux_amd64.tar.gz -o /tmp/podman.tgz \
    && echo '38b8b536201921410f5a05b6faad06fb36d2a551d2f38ccb58480c5b8cef7347  /tmp/podman.tgz' | sha256sum -c - \
    && tar -xzf /tmp/podman.tgz -C /tmp bin/podman-remote-static-linux_amd64 \
    && install -m 0755 /tmp/bin/podman-remote-static-linux_amd64 /usr/local/bin/podman \
    && rm /tmp/podman.tgz /tmp/bin/podman-remote-static-linux_amd64
WORKDIR /app
COPY --from=build --chown=maus:maus /src/dist-native/duckdb/linux-x64 ./duckdb
COPY --from=build --chown=maus:maus /src/dist-server ./dist-server
COPY --from=build --chown=maus:maus /src/dist ./dist
ARG ENGINES=""
RUN if [ -n "$ENGINES" ]; then npm install -g $ENGINES; fi
ENV HOME=/data \
    SAGAX_DUCKDB_DIR=/app/duckdb \
    OMB_DATA_DIR=/data/.openmausbot \
    OMB_STATIC_DIR=/app/dist \
    OMB_PORT=8799 \
    OMB_WEBHOOK_PORT=8800 \
    NODE_ENV=production
USER maus
# Starts dist-server/index.js again when it asks to (server/process/restart.ts).
CMD ["node", "dist-server/server-launcher.js"]
