#!/bin/bash
# sagax-desktop: the on-demand desktop of a Sagax server environment
# (docs/user-sandbox.md, "Desktop"). Nothing runs until a computer-use tool or
# the person's live view asks for it, so plain shell turns stay light.
#
#   sagax-desktop start            start Xvnc, openbox, the background and
#                                  the dock (idempotent); with
#                                  SAGAX_VNC_FULL and SAGAX_VNC_VIEW set, also
#                                  replace the two VNC passwords
#   sagax-desktop status           "running" or "stopped"
#   sagax-desktop screenshot       JPEG of the screen, base64 on stdout
#   sagax-desktop xdotool ARGS...  run xdotool on the desktop (fixed argv)
#   sagax-desktop type             type $SAGAX_TEXT
#   sagax-desktop open-url         open $SAGAX_URL in Chromium
#   sagax-desktop browser [URL]    Chromium (the dock, html files)
#   sagax-desktop files [DIR]      Thunar, /workspace by default
#   sagax-desktop terminal         Xfce Terminal in /workspace
#   sagax-desktop relay            stdin/stdout <-> the VNC port (the live
#                                  view's only path in: sandboxd attaches to
#                                  this through docker exec)
#
# The VNC server listens on 127.0.0.1 inside this sandbox's own network
# namespace only, and asks for a password: the full one controls the screen,
# the view-only one only watches.
set -euo pipefail

export DISPLAY=:1
# GSettings in a file of HOME (Plank's settings): no dconf service here.
export GSETTINGS_BACKEND=keyfile
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/workspace/.config}"

# The values Sagax hands this script (passwords, typed text, an address)
# become plain shell variables, never exported: Xvnc, openbox, tint2 and
# Chromium start from here and run on, and /proc/<pid>/environ of a
# long-running process is readable by every process of the sandbox user.
VNC_FULL="${SAGAX_VNC_FULL:-}"
VNC_VIEW="${SAGAX_VNC_VIEW:-}"
TYPE_TEXT="${SAGAX_TEXT:-}"
OPEN_URL="${SAGAX_URL:-}"
unset SAGAX_VNC_FULL SAGAX_VNC_VIEW SAGAX_TEXT SAGAX_URL
STATE=/tmp/sagax-desktop
RFB_PORT=5901
WIDTH=1280
HEIGHT=800

log() { printf '%s\n' "$*" >&2; }

running() {
  pgrep -u "$(id -u)" -x Xvnc >/dev/null 2>&1 && [ -S /tmp/.X11-unix/X1 ]
}

random_password() {
  # VNC authentication uses at most 8 characters.
  head -c 64 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 8
}

write_passwords() {
  local full="$1" view="$2"
  mkdir -p "$STATE"
  chmod 0700 "$STATE"
  umask 077
  local next
  next="$(mktemp "$STATE/passwd.XXXXXX")"
  printf '%s\n%s\n' "$full" "$view" | vncpasswd -f > "$next"
  mv -f "$next" "$STATE/passwd"
}

start() {
  mkdir -p "$STATE" /tmp/.X11-unix
  chmod 0700 "$STATE"
  # One start at a time: two at once raced on the password file and could
  # both launch Xvnc.
  exec 9>"$STATE/start.lock"
  flock -w 25 9 || { log "another start of the desktop is still running"; exit 1; }
  chmod 1777 /tmp/.X11-unix 2>/dev/null || true
  if [ -n "$VNC_FULL" ] && [ -n "$VNC_VIEW" ]; then
    write_passwords "$VNC_FULL" "$VNC_VIEW"
  elif [ ! -s "$STATE/passwd" ]; then
    write_passwords "$(random_password)" "$(random_password)"
  fi
  if running; then
    session
    exec 9>&-
    echo running
    return 0
  fi
  rm -f /tmp/.X11-unix/X1 /tmp/.X1-lock "$STATE/background"
  setsid Xvnc :1 \
    -geometry "${WIDTH}x${HEIGHT}" -depth 24 \
    -rfbport "$RFB_PORT" -localhost -interface 127.0.0.1 \
    -nolisten tcp -SecurityTypes VncAuth -rfbauth "$STATE/passwd" \
    -AlwaysShared -AcceptSetDesktopSize=0 \
    >"$STATE/xvnc.log" 2>&1 </dev/null 9>&- &
  for _ in $(seq 1 50); do
    if [ -S /tmp/.X11-unix/X1 ] && xdotool getdisplaygeometry >/dev/null 2>&1; then break; fi
    sleep 0.1
  done
  if ! running; then
    log "the desktop did not start"
    tail -n 20 "$STATE/xvnc.log" >&2 || true
    exit 1
  fi
  session
  exec 9>&-
  sleep 0.3
  echo running
}

# The session bus the Xfce apps (Thunar, Xfce Terminal, Mousepad) and
# Plank talk over, one per desktop start, its address in $STATE.
bus() {
  if [ -s "$STATE/dbus.env" ]; then
    # shellcheck disable=SC1091
    . "$STATE/dbus.env"
    if [ -n "${DBUS_SESSION_BUS_PID:-}" ] && kill -0 "$DBUS_SESSION_BUS_PID" 2>/dev/null; then
      export DBUS_SESSION_BUS_ADDRESS
      return 0
    fi
  fi
  command -v dbus-launch >/dev/null 2>&1 || return 0
  dbus-launch --sh-syntax 9>&- 2>/dev/null | grep -E '^DBUS_SESSION_BUS_(ADDRESS|PID)=' > "$STATE/dbus.env" || true
  # shellcheck disable=SC1091
  [ -s "$STATE/dbus.env" ] && . "$STATE/dbus.env" && export DBUS_SESSION_BUS_ADDRESS
}

# The dock's items and settings, written at each start (they live in HOME,
# which the person may have changed or emptied): Chromium, Files, Terminal,
# always shown, no Plank icon of its own.
dock_config() {
  local dir="$XDG_CONFIG_HOME/plank/dock1/launchers" item
  mkdir -p "$dir" "$XDG_CONFIG_HOME/glib-2.0/settings"
  # Thunar's and Xfce Terminal's own entries, so the dock shows their open
  # windows on the same icon (Thunar opens HOME, /workspace).
  rm -f "$dir"/sagax-files.dockitem "$dir"/sagax-terminal.dockitem
  for item in sagax-browser thunar xfce4-terminal; do
    printf '[PlankDockItemPreferences]\nLauncher=file:///usr/share/applications/%s.desktop\n' "$item" > "$dir/$item.dockitem"
  done
  local keyfile="$XDG_CONFIG_HOME/glib-2.0/settings/keyfile"
  local group="[net/launchpad/plank/docks/dock1]"
  local body
  body="$(printf '%s\n' "$group" \
    "dock-items=['sagax-browser.dockitem', 'thunar.dockitem', 'xfce4-terminal.dockitem']" \
    "hide-mode='none'" "icon-size=44" "theme='Transparent'" "position='bottom'" \
    "alignment='center'" "lock-items=true" "show-dock-item=false" "zoom-enabled=false" "pressure-reveal=false")"
  if [ -f "$keyfile" ]; then
    # keep the other groups, replace the dock's own
    python3 -I -c '
import sys
path, group, body = sys.argv[1], sys.argv[2], sys.argv[3]
out, skip = [], False
for line in open(path, encoding="utf-8", errors="replace").read().splitlines():
    if line.startswith("["):
        skip = line.strip() == group
    if not skip:
        out.append(line)
open(path, "w", encoding="utf-8").write("\n".join([l for l in out if l.strip()] + [""] + body.splitlines()) + "\n")
' "$keyfile" "$group" "$body" 2>/dev/null || printf '%s\n' "$body" > "$keyfile"
  else
    printf '%s\n' "$body" > "$keyfile"
  fi
  # Thunar's side pane: the bots' folders and the shared one under Places.
  local marks="$XDG_CONFIG_HOME/gtk-3.0/bookmarks"
  mkdir -p "$XDG_CONFIG_HOME/gtk-3.0" /workspace/bots /workspace/shared 2>/dev/null || true
  if [ ! -s "$marks" ]; then
    printf 'file:///workspace/bots Bots\nfile:///workspace/shared Shared\n' > "$marks"
  fi
}

# The desktop around the windows: openbox, a light background and the dock
# (Chromium, Files, Terminal). Each starts only when missing, so a person
# watching never sees an empty black screen. No taskbar: the dock shows the
# open apps.
session() {
  bus
  if ! pgrep -u "$(id -u)" -x openbox >/dev/null 2>&1; then
    setsid openbox --sm-disable >"$STATE/openbox.log" 2>&1 </dev/null 9>&- &
  fi
  if [ ! -e "$STATE/background" ] && command -v hsetroot >/dev/null 2>&1; then
    hsetroot -add "#f6f7f9" -add "#e6e8ec" -add "#d3d7de" -gradient 180 >/dev/null 2>&1 && : > "$STATE/background"
  fi
  if ! pgrep -u "$(id -u)" -x xcompmgr >/dev/null 2>&1 && command -v xcompmgr >/dev/null 2>&1; then
    setsid xcompmgr -n >"$STATE/xcompmgr.log" 2>&1 </dev/null 9>&- &
  fi
  if ! pgrep -u "$(id -u)" -x plank >/dev/null 2>&1 && command -v plank >/dev/null 2>&1; then
    dock_config
    setsid plank >"$STATE/plank.log" 2>&1 </dev/null 9>&- &
  fi
}

chromium_running() {
  pgrep -u "$(id -u)" -f -- '--class=sagax-desktop-browser' >/dev/null 2>&1
}

browser() {
  bus
  mkdir -p /workspace/.sagax
  setsid chromium \
    --class=sagax-desktop-browser \
    --user-data-dir=/workspace/.sagax/chromium \
    --no-sandbox --test-type --disable-dev-shm-usage --disable-gpu \
    --no-first-run --no-default-browser-check --password-store=basic \
    --disk-cache-dir=/tmp/sagax-desktop/chromium-cache --disk-cache-size=67108864 \
    --window-position=0,0 --window-size="${WIDTH},${HEIGHT}" \
    "$@" >"$STATE/chromium.log" 2>&1 </dev/null &
}

case "${1:-}" in
  start)
    start
    ;;
  status)
    if running; then echo running; else echo stopped; fi
    ;;
  screenshot)
    start >/dev/null
    rm -f "$STATE/shot.jpg"
    scrot -o -q 70 "$STATE/shot.jpg" >/dev/null 2>&1
    base64 -w0 "$STATE/shot.jpg"
    rm -f "$STATE/shot.jpg"
    ;;
  xdotool)
    shift
    start >/dev/null
    exec xdotool "$@"
    ;;
  type)
    start >/dev/null
    exec xdotool type --clearmodifiers --delay 8 -- "$TYPE_TEXT"
    ;;
  open-url)
    start >/dev/null
    case "$OPEN_URL" in
      http://*|https://*) ;;
      *) log "only http and https addresses"; exit 2 ;;
    esac
    browser "$OPEN_URL"
    echo opened
    ;;
  browser|terminal|files)
    what="$1"
    shift
    start >/dev/null
    bus
    case "$what" in
      # A page or a file the person opened from Files (file://, http(s)://).
      browser)
        args=()
        for arg in "$@"; do
          case "$arg" in
            http://*|https://*|file://*) args+=("$arg") ;;
            /*) args+=("file://$arg") ;;
          esac
        done
        browser "${args[@]}"
        ;;
      terminal) setsid xfce4-terminal --disable-server --working-directory=/workspace >"$STATE/terminal.log" 2>&1 </dev/null & ;;
      files)
        dir=/workspace
        for arg in "$@"; do
          case "$arg" in
            file://*) dir="${arg#file://}" ;;
            /*) dir="$arg" ;;
          esac
        done
        setsid thunar "$dir" >"$STATE/thunar.log" 2>&1 </dev/null &
        ;;
    esac
    echo opened
    ;;
  relay)
    running || { log "the desktop is not running"; exit 3; }
    exec python3 -c '
import os, socket, sys, threading
sock = socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=10)
sock.settimeout(None)
def upstream():
    try:
        while True:
            data = os.read(0, 65536)
            if not data:
                break
            sock.sendall(data)
    finally:
        try: sock.shutdown(socket.SHUT_WR)
        except OSError: pass
threading.Thread(target=upstream, daemon=True).start()
out = sys.stdout.buffer
while True:
    data = sock.recv(65536)
    if not data:
        break
    out.write(data)
    out.flush()
' "$RFB_PORT"
    ;;
  *)
    log "usage: sagax-desktop start|status|screenshot|xdotool ARGS|type|open-url|browser|terminal|files|relay"
    exit 2
    ;;
esac
