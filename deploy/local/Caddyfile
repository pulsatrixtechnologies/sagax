:80 {
	map {host} {upstream_scheme} {
		{$OMB_HTTPS_HOST:https-disabled.invalid} {$OMB_UPSTREAM_SCHEME:http}
		default http
	}
	encode zstd gzip
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800 {
			lb_try_duration 25s
			lb_try_interval 250ms
			fail_duration 10s
			unhealthy_status 502 503
			health_uri /healthz
			health_interval 2s
			health_timeout 1s
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-Proto {upstream_scheme}
			lb_try_duration 25s
			lb_try_interval 250ms
			fail_duration 10s
			unhealthy_status 502 503
			health_uri /healthz
			health_interval 2s
			health_timeout 1s
			flush_interval -1
		}
	}
}
