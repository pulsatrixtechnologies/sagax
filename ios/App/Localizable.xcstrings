    "This bot's memory was changed in a conversation you didn't write, so it can't use your Mac. Check the notes below, then mark them reviewed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot's memory was changed in a conversation you didn't write, so it can't use your Mac. Check the notes below, then mark them reviewed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire de ce bot a changé dans une conversation que vous n'avez pas écrite : il ne peut pas utiliser votre Mac. Vérifiez les notes ci-dessous, puis marquez-les comme revues."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória deste bot mudou numa conversa que você não escreveu, então ele não pode usar seu Mac. Confira as notas abaixo e marque-as como revisadas."
          }
        }
      }
    },
    "This bot's owner is disabled: their routines can't run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot's owner is disabled: their routines can't run."
