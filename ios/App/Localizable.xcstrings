          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin não adicionou nenhum servidor MCP nem habilidade que o Sagax possa usar."
          }
        }
      }
    },
    "This plugin is no longer installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plugin is no longer installed."
          }
        },
        "fr": {
