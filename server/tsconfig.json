{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // node --experimental-strip-types runs this code in development; it refuses
    // parameter properties, enums and namespaces, so the compiler does too.
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    ".",
    "../companion",
    "../shared/profil-fiche.ts",
    "../shared/profil-fiche.test.ts",
    "../shared/bot-analytics.ts",
    "../shared/bot-analytics.test.ts",
    // pure IT tools model: typechecked under the server's no-DOM lib so it stays usable on both sides
    "../shared/net-tools"
  ],
  "exclude": [
    "drivers/pi-mcp-extension.ts"
  ]
}
