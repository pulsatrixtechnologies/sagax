    "Your saved runs of this routine are deleted for good. Runs in progress are kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos exécutions enregistrées de cette routine sont supprimées définitivement. Les exécutions en cours sont conservées."
