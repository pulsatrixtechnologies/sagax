          "stringUnit": {
            "state": "translated",
            "value": "Cette demande ne peut pas être scellée pour votre ordinateur. Redemandez depuis le formulaire Nouvelle carte."
          }
        }
      }
    },
    "This request was replaced by a newer one for the same key. Use the newest card to provide it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request was replaced by a newer one for the same key. Use the newest card to provide it."
