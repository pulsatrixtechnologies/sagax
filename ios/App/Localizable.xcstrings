    "One approval level, and the rules that come first. Pick an effect for the ones that suit this bot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One approval level, and the rules that come first. Pick an effect for the ones that suit this bot."
