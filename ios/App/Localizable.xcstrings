    "%@ asks you the questions and fills in each step live, right beside the conversation. You can correct any field.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks you the questions and fills in each step live, right beside the conversation. You can correct any field."
