    "Let this bot use memory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let this bot use memory"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser ce bot utiliser la mémoire"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar este bot usar a memória"
          }
        }
      }
    },
    "Off stops memory prompts, recall, native memory tools, upkeep, and automatic turn logs. Existing files remain available for review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off stops memory prompts, recall, native memory tools, upkeep, and automatic turn logs. Existing files remain available for review."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé arrête les invites de mémoire, le rappel, les outils de mémoire natifs, l'entretien et les journaux de tour automatiques. Les fichiers existants restent consultables."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado interrompe os prompts de memória, a recordação, as ferramentas nativas de memória, a manutenção e os registros automáticos de turno. Os arquivos existentes continuam disponíveis para revisão."
          }
        }
      }
    },
    "Stop this bot's turn before changing this setting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop this bot's turn before changing this setting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez le tour de ce bot avant de changer ce réglage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare o turno deste bot antes de mudar esta configuração."
          }
        }
      }
    },
    "Notes this bot keeps between tasks. They are plain markdown files in a folder on your computer. Open them in any editor, or in Obsidian.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes this bot keeps between tasks. They are plain markdown files in a folder on your computer. Open them in any editor, or in Obsidian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes que ce bot garde entre ses tâches. Ce sont de simples fichiers markdown dans un dossier de votre ordinateur : ouvrez-les dans n'importe quel éditeur, ou dans Obsidian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas que este bot guarda entre tarefas. São arquivos markdown simples numa pasta do seu computador: abra-os em qualquer editor ou no Obsidian."
          }
        }
      }
    },
    "The memory changed again after you looked, so it can't use your Mac yet. Check the notes below, then mark them reviewed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memory changed again after you looked, so it can't use your Mac yet. Check the notes below, then mark them reviewed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire a encore changé depuis votre lecture : elle ne peut pas encore utiliser votre Mac. Vérifiez les notes ci-dessous, puis marquez-les comme revues."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória mudou de novo depois que você olhou, então ainda não pode usar seu Mac. Confira as notas abaixo e marque-as como revisadas."
          }
        }
      }
    },
    "This bot's memory was changed in a conversation you didn't write, so it can't use your Mac. Check the notes below, then mark them reviewed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
