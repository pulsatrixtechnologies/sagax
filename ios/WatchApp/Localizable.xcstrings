    "The watch listens to the meeting around you until you stop. The red pill shows the people in the room that it listens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watch listens to the meeting around you until you stop. The red pill shows the people in the room that it listens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La montre écoute la réunion autour de toi jusqu’à ce que tu arrêtes. La pastille rouge montre aux personnes présentes qu’elle écoute."
          }
        }
      }
    },
