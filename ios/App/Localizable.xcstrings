    },
    "Attach up to 32 items at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach up to 32 items at a time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez au plus 32 éléments à la fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe até 32 itens por vez."
          }
        }
      }
    },
    "Those images are larger than 200 MB together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those images are larger than 200 MB together."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces images dépassent 200 Mo au total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas imagens ultrapassam 200 MB no total."
          }
        }
      }
    },
    "%@ isn't a supported file. Try an image, document, archive, audio, or video file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't a supported file. Try an image, document, archive, audio, or video file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un fichier non pris en charge. Essayez une image, un document, une archive, un audio ou une vidéo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é um arquivo compatível. Tente uma imagem, documento, arquivo compactado, áudio ou vídeo."
          }
        }
      }
    },
    "%@ isn't a supported attachment. Try an image, document, archive, audio, or video file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
