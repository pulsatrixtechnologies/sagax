          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a aucun compte à supprimer. Ce téléphone oublie l'ordinateur et efface ses données associées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
