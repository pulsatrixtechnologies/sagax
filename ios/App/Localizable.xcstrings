          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courriels, messages, publications, invitations et paiements par les apps connectées. Lire et rédiger ne comptent jamais. Cela s'applique à tous les niveaux d'approbation, y compris l'accès complet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails, mensagens, posts, convites e pagamentos pelos apps conectados. Ler e rascunhar nunca contam. Isso vale em todos os níveis de aprovação, inclusive Acesso total."
          }
