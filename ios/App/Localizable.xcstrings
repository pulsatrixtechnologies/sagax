            "state": "translated",
            "value": "Um rótulo para a conta, como trabalho ou pessoal."
          }
        }
      }
    },
    "A large Updates button at the bottom of the home, to see what the bots did at a glance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large Updates button at the bottom of the home, to see what the bots did at a glance."
