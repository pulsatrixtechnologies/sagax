            "state": "translated",
            "value": "Seu login no Pulsatrix terminou. Entre de novo para continuar usando suas conversas aqui."
          }
        }
      }
    },
    "This session was signed out from another device or by an administrator. Sign in again to keep using your chats here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a été fermée depuis un autre appareil ou par un administrateur. Reconnectez-vous pour continuer à utiliser vos conversations ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão foi encerrada em outro dispositivo ou por um administrador. Entre de novo para continuar usando suas conversas aqui."
          }
        }
      }
    },
    "This session expired after a long time without use. Sign in again to keep using your chats here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
