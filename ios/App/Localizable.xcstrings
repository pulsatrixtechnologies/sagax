    },
    "Loaded pack: %@": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loaded pack: %@" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Pack chargé : %@" } }
