          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre bot principal, votre contact principal. Il coordonne vos autres bots et spécialistes (équipe d'attache : %@), puis réunit leur travail en une seule réponse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu bot principal, o seu contato principal. Ele coordena seus outros bots e especialistas (equipe de origem: %@) e depois junta o trabalho deles em uma só resposta."
          }
        }
