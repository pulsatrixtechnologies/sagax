    },
    "Once the month's cost reaches the limit, no bot in this installation starts a turn until an admin raises it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the month's cost reaches the limit, no bot in this installation starts a turn until an admin raises it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois le plafond du mois atteint, aucun bot de cette installation ne démarre de tour jusqu'à ce qu'un admin le relève."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o custo do mês atinge o limite, nenhum bot desta instalação inicia um turno até um admin aumentá-lo."
          }
        }
      }
    },
    "One approval level, and the rules that come first. Pick an effect for the ones that suit this bot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One approval level, and the rules that come first. Pick an effect for the ones that suit this bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul niveau d'approbation, et les règles qui passent en premier. Choisissez un effet pour celles qui conviennent à ce bot."
          }
        }
      }
    },
    "One approval level, and the rules that come first. Tick the ones that suit this bot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One approval level, and the rules that come first. Tick the ones that suit this bot."
