          }
        }
      }
    },
    "The group leaves your sidebar and you stop getting its messages and notifications. Your messages stay for the others, and your private bots leave with you. Someone in the group can add you back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group leaves your sidebar and you stop getting its messages and notifications. Your messages stay for the others, and your private bots leave with you. Someone in the group can add you back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le groupe quitte votre barre latérale et vous ne recevez plus ses messages ni ses notifications. Vos messages restent pour les autres, et vos bots privés partent avec vous. Une personne du groupe peut vous rajouter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele sai da sua barra lateral e você deixa de receber as mensagens e notificações. Suas mensagens ficam para os outros, e seus bots privados saem com você. Alguém do grupo pode adicionar você de novo."
          }
        }
      }
    },
